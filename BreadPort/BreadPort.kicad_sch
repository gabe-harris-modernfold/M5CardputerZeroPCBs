	)
	(text "Power: 5VOUT (pin 6, switch on in Settings > ExtPort) -> U1 SY6280AAC, limit 6800 / R1 = 378 mA typ (+-25%) -> U2 3.3 V LDO"
		(exclude_from_sim no)
		(at 25.4 264.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1630292c-2b1c-5ff1-8933-04cdee45f9fd")
	)
	(text "U1 blocks reverse current, so nothing on BreadPort can back-feed the host's 5 V"
		(exclude_from_sim no)
		(at 25.4 269.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3bc12177-97c6-544a-a41c-3674ecdc27aa")
	)
	(text "Q1/Q2: I2C isolation. Gates on BreadPort's 3.3 V; unpowered, the external bus is cut off from the host's I2C1"
		(exclude_from_sim no)
		(at 25.4 274.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "26d96ba0-6fd4-5489-845e-5c560d7508a7")
	)
	(text "U3 ADS1115 at 0x48 (host bus uses 0x10, 0x32, 0x34, 0x4F, 0x55, 0x68). Inputs 0-3.3 V; R5-R8 limit fault current"
		(exclude_from_sim no)
		(at 25.4 279.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2226e483-1c80-51de-9c2e-c582c5c71c14")
	)
