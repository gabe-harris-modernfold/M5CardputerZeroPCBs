{
  "mcpServers": {
    "kicad": {
      "type": "stdio",
      "command": "${USERPROFILE}\\.local\\bin\\kicad-mcp-pro.exe",
      "args": [],
      "env": {
        "KICAD_MCP_PROJECT_DIR": "C:\\SourceCode\\M5CardputerZeroPCBs",
        "KICAD_MCP_PROFILE": "full",
        "KICAD_MCP_OPERATING_MODE": "write",
        "KICAD_MCP_TRANSPORT": "stdio"
